{
	"name": "pi-fit",
	"version": "0.1.0",
	"description": "Deterministic FIT ticket tools for Pi agents, plus a human fuzzy /fit command",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"fit",
		"tickets",
		"issue-tracker",
		"markdown",
		"a2ui"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"bin": {
		"pi-fit": "./src/cli.ts"
	},
	"files": [
		"src",
		"README.md",
		"AI_DISCLOSURE.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"test": "node --test test/*.test.ts",
		"typecheck": "tsc --noEmit",
		"check": "npm run typecheck && npm test"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@a2ui/web_core": "0.15.0",
		"@types/node": "^22.19.0",
		"typescript": "^5.9.0"
	}
}
